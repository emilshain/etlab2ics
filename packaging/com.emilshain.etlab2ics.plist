<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: launchd agent.
     cp packaging/com.emilshain.etlab2ics.plist ~/Library/LaunchAgents/
     edit the two paths, then:
     launchctl load ~/Library/LaunchAgents/com.emilshain.etlab2ics.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.emilshain.etlab2ics</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/ABSOLUTE/PATH/calendar-bridge.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/etlab2ics.log</string>
  <key>StandardErrorPath</key><string>/tmp/etlab2ics.log</string>
</dict>
</plist>
